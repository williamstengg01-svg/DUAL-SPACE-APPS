    <string name="step_battery_title">Battery optimisation</string>
    <string name="step_battery_desc">Choose “Allow” / “Don’t optimise” so Android does not put Dual Space to sleep.</string>
    <string name="step_autostart_title">Autostart</string>
    <string name="step_autostart_desc_xiaomi">In Security → Autostart, turn on the switch next to Dual Space.</string>
    <string name="step_autostart_desc_vivo">In i Manager → App manager → Autostart manager, enable Dual Space.</string>
    <string name="step_autostart_desc_oppo">In Phone Manager → Privacy → Startup manager (Auto-launch), enable Dual Space.</string>
    <string name="step_sleeping_title">Never-sleeping apps</string>
    <string name="step_sleeping_desc_samsung">Battery → Background usage limits → “Never sleeping apps” → add Dual Space. Also remove it from “Sleeping” and “Deep sleeping” lists.</string>
    <string name="step_popup_title">Background pop-ups</string>
    <string name="step_popup_desc_xiaomi">In the permission page, allow “Display pop-up windows while running in the background” and “Display pop-up window”.</string>
    <string name="step_popup_desc_vivo">Allow “Background pop-ups” and “Display over other apps” for Dual Space.</string>
    <string name="step_power_title">Background power</string>
    <string name="step_power_desc_xiaomi">Battery saver → choose “No restrictions” for Dual Space.</string>
    <string name="step_power_desc_vivo">Background power consumption → allow high background power for Dual Space.</string>
    <string name="step_power_desc_oppo">Battery → App battery management → Dual Space → “Allow background activity” / disable “Smart power”.</string>
    <string name="step_notif_title">Notifications</string>
    <string name="step_notif_desc">Make sure notifications are enabled — cloned apps deliver their notifications through Dual Space.</string>

