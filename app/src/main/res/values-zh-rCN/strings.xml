    <string name="step_battery_title">电池优化</string>
    <string name="step_battery_desc">选择“允许”/“不优化”，避免系统让 Dual Space 休眠。</string>
    <string name="step_autostart_title">自启动</string>
    <string name="step_autostart_desc_xiaomi">在 手机管家 → 自启动管理 中，打开 Dual Space 旁的开关。</string>
    <string name="step_autostart_desc_vivo">在 i 管家 → 应用管理 → 自启动管理 中启用 Dual Space。</string>
    <string name="step_autostart_desc_oppo">在 手机管家 → 权限隐私 → 自启动管理 中启用 Dual Space。</string>
    <string name="step_sleeping_title">永不休眠的应用</string>
    <string name="step_sleeping_desc_samsung">电池 → 后台使用限制 → “永不休眠的应用” → 添加 Dual Space，并从“休眠”和“深度休眠”列表中移除。</string>
    <string name="step_popup_title">后台弹出界面</string>
    <string name="step_popup_desc_xiaomi">在权限页面允许“后台弹出界面”和“显示悬浮窗”。</string>
    <string name="step_popup_desc_vivo">为 Dual Space 允许“后台弹出界面”和“悬浮窗”。</string>
    <string name="step_power_title">后台耗电</string>
    <string name="step_power_desc_xiaomi">省电策略 → 为 Dual Space 选择“无限制”。</string>
    <string name="step_power_desc_vivo">后台高耗电 → 允许 Dual Space 后台高耗电运行。</string>
    <string name="step_power_desc_oppo">电池 → 应用耗电管理 → Dual Space → “允许后台运行” / 关闭“智能后台”。</string>
    <string name="step_notif_title">通知</string>
    <string name="step_notif_desc">请确认通知已开启——分身应用的通知通过 Dual Space 发送。</string>

